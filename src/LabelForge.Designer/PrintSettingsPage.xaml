<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LabelMaker.PrintSettingsPage"
             Title="Print Settings"
             BackgroundColor="White">
    
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            
            <Label Text="Print Settings" 
                   FontSize="24" 
                   FontAttributes="Bold"
                   HorizontalOptions="Center"/>
            
            <BoxView HeightRequest="1" BackgroundColor="#E0E0E0"/>
            
            <!-- Copies -->
            <Grid ColumnDefinitions="120,*">
                <Label Grid.Column="0" 
                       Text="Copies:" 
                       VerticalOptions="Center"
                       FontAttributes="Bold"/>
                <Stepper Grid.Column="1" 
                         x:Name="CopiesStepper"
                         Minimum="1" 
                         Maximum="99" 
                         Value="1"
                         ValueChanged="OnCopiesChanged"/>
            </Grid>
            <Label x:Name="CopiesLabel" 
                   Text="1 copy" 
                   HorizontalOptions="End"/>
            
            <!-- Paper Size -->
            <Grid ColumnDefinitions="120,*">
                <Label Grid.Column="0" 
                       Text="Paper Size:" 
                       VerticalOptions="Center"
                       FontAttributes="Bold"/>
                <Picker Grid.Column="1" 
                        x:Name="PaperSizePicker"
                        SelectedIndex="0">
                    <Picker.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String>A4</x:String>
                            <x:String>Letter</x:String>
                            <x:String>Legal</x:String>
                            <x:String>A5</x:String>
                            <x:String>A6</x:String>
                            <x:String>Custom</x:String>
                        </x:Array>
                    </Picker.ItemsSource>
                </Picker>
            </Grid>
            
            <!-- Orientation -->
            <Grid ColumnDefinitions="120,*">
                <Label Grid.Column="0" 
                       Text="Orientation:" 
                       VerticalOptions="Center"
                       FontAttributes="Bold"/>
                <Picker Grid.Column="1" 
                        x:Name="OrientationPicker"
                        SelectedIndex="0">
                    <Picker.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String>Portrait</x:String>
                            <x:String>Landscape</x:String>
                        </x:Array>
                    </Picker.ItemsSource>
                </Picker>
            </Grid>
            
            <!-- Fit to Page -->
            <HorizontalStackLayout Spacing="10">
                <CheckBox x:Name="FitToPageCheckBox" IsChecked="True"/>
                <Label Text="Fit to Page" VerticalOptions="Center"/>
            </HorizontalStackLayout>
            
            <BoxView HeightRequest="1" BackgroundColor="#E0E0E0"/>
            <Label Text="Margins (mm)" FontAttributes="Bold" FontSize="16"/>
            
            <!-- Margins -->
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
                <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="5">
                    <Label Text="Top:" FontAttributes="Bold"/>
                    <Entry x:Name="MarginTopEntry" Text="10" Keyboard="Numeric"/>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="5">
                    <Label Text="Bottom:" FontAttributes="Bold"/>
                    <Entry x:Name="MarginBottomEntry" Text="10" Keyboard="Numeric"/>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="5">
                    <Label Text="Left:" FontAttributes="Bold"/>
                    <Entry x:Name="MarginLeftEntry" Text="10" Keyboard="Numeric"/>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="5">
                    <Label Text="Right:" FontAttributes="Bold"/>
                    <Entry x:Name="MarginRightEntry" Text="10" Keyboard="Numeric"/>
                </VerticalStackLayout>
            </Grid>
            
            <BoxView HeightRequest="1" BackgroundColor="#E0E0E0"/>
            
            <!-- Buttons -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Grid.Column="0" 
                        Text="Print Preview" 
                        BackgroundColor="#17A2B8"
                        TextColor="White"
                        Clicked="OnPreviewClicked"/>
                <Button Grid.Column="1" 
                        Text="Print" 
                        BackgroundColor="#28A745"
                        TextColor="White"
                        Clicked="OnPrintClicked"/>
            </Grid>
            
            <Button Text="Cancel" 
                    BackgroundColor="#6C757D"
                    TextColor="White"
                    Clicked="OnCancelClicked"/>
            
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
